<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/selected" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="@color/selected_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/panel"
                android:centerColor="#243B82F6"
                android:endColor="@color/panel" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="#553B82F6" />
        </shape>
    </item>
</selector>
