<resources>
    <string name="network_tuning_section">Connection and network tuning</string>
    <string name="network_tuning_summary">Applies only documented Xray socket options. Existing provider values are preserved. The buffer value controls bounded Kotlin-side network reads, not libXray native traffic.</string>
    <string name="network_tuning_enabled">Enable safe network tuning</string>
    <string name="adaptive_handshake">Adaptive fast handshake and route verification</string>
    <string name="tcp_fast_open">Request TCP Fast Open when supported</string>
    <string name="tcp_keepalive_idle">TCP keep-alive idle (seconds, 0 disables override)</string>
    <string name="tcp_keepalive_interval">TCP keep-alive interval (seconds, 0 disables override)</string>
    <string name="tcp_user_timeout">TCP user timeout (milliseconds, 0 disables override)</string>
    <string name="network_buffer_size_kb">Bounded app network buffer (KiB, 8–256)</string>
    <string name="wireguard_section_v9">WireGuard through Xray 26.7.28</string>
    <string name="wireguard_summary_v9">Controls Xray’s userspace WireGuard outbound. Imported lower MTU and explicit peer values always take priority. AmneziaWG-only obfuscation still requires an AmneziaWG backend.</string>
    <string name="wireguard_mtu_v9">WireGuard MTU ceiling (576–9000)</string>
    <string name="wireguard_workers_v9">WireGuard workers (1–8)</string>
    <string name="wireguard_keepalive_v9">Default peer keep-alive (seconds, 0 disables)</string>
    <string name="wireguard_handshake_timeout_v9">Startup verification budget (milliseconds, 5000–60000)</string>
    <string name="wireguard_domain_strategy_v9">WireGuard domain strategy</string>
    <string name="invalid_network_tuning_v9">One or more network/WireGuard tuning values are outside the allowed range.</string>
</resources>
