<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trivox.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/blue</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textViewStyle">@style/Widget.Trivox.TextView.Default</item>
        <item name="android:buttonStyle">@style/Widget.Trivox.Button.Default</item>
        <item name="buttonStyle">@style/Widget.Trivox.Button.Default</item>
        <item name="android:editTextStyle">@style/Widget.Trivox.EditText.Default</item>
        <item name="editTextStyle">@style/Widget.Trivox.EditText.Default</item>
        <item name="android:spinnerStyle">@style/Widget.Trivox.Spinner.Default</item>
        <item name="spinnerStyle">@style/Widget.Trivox.Spinner.Default</item>
        <item name="android:checkboxStyle">@style/Widget.Trivox.CheckBox</item>
        <item name="checkboxStyle">@style/Widget.Trivox.CheckBox</item>
        <item name="android:radioButtonStyle">@style/Widget.Trivox.RadioButton.Default</item>
        <item name="radioButtonStyle">@style/Widget.Trivox.RadioButton.Default</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Trivox.AlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Trivox.AlertDialog</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="toolbarStyle">@style/Widget.Trivox.Toolbar</item>
    </style>

    <style name="Theme.Trivox" parent="Theme.Trivox.Base">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.Trivox.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="ThemeOverlay.Trivox.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textViewStyle">@style/Widget.Trivox.TextView.Default</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>

    <style name="ThemeOverlay.Trivox.Popup" parent="ThemeOverlay.AppCompat">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:textViewStyle">@style/Widget.Trivox.TextView.Default</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorControlNormal">@color/text_primary</item>
    </style>

    <style name="Widget.Trivox.TextView.Default" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.Trivox.Button.Default" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.EditText.Default" parent="Widget.AppCompat.EditText">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.Trivox.Spinner.Default" parent="Widget.AppCompat.Spinner">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="Widget.Trivox.RadioButton.Default" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.Trivox.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/transparent</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Trivox.Toolbar</item>
        <item name="popupTheme">@style/ThemeOverlay.Trivox.Popup</item>
        <item name="android:contentInsetStart">4dp</item>
        <item name="contentInsetStart">4dp</item>
        <item name="contentInsetEnd">4dp</item>
    </style>

    <style name="TextAppearance.Trivox.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Trivox.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Button.LivePing" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:background">@drawable/live_ping_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Input" parent="Widget.AppCompat.EditText">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Trivox.SectionTitle" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">11dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Trivox.FieldLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Trivox.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
