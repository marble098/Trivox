<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trivox.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Trivox" parent="Theme.Trivox.Base" />

    <style name="Theme.Trivox.Transparent" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="ThemeOverlay.Trivox">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>

    <style name="ThemeOverlay.Trivox.AlertDialog" parent="ThemeOverlay.Trivox" />

    <style name="ThemeOverlay.Trivox.Popup" parent="ThemeOverlay.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Trivox.TextView" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Trivox.TextView.Default" parent="Widget.Trivox.TextView" />

    <style name="Widget.Trivox.Button" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Trivox.Button.Default" parent="Widget.Trivox.Button" />

    <style name="Widget.Trivox.EditText" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Widget.Trivox.EditText.Default" parent="Widget.Trivox.EditText" />

    <style name="Widget.Trivox.Spinner" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="Widget.Trivox.Spinner.Default" parent="Widget.Trivox.Spinner" />

    <style name="Widget.Trivox.RadioButton" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.Trivox.RadioButton.Default" parent="Widget.Trivox.RadioButton" />

    <style name="Widget.Trivox.CheckBox" parent="Widget.Trivox">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Trivox.Toolbar" parent="Widget.Trivox">
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="TextAppearance.Trivox.Toolbar" parent="Widget.Trivox.TextView">
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Trivox.Button.Primary" parent="Widget.Trivox.Button">
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Button.Secondary" parent="Widget.Trivox.Button">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Button.LivePing" parent="Widget.Trivox.Button">
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:background">@drawable/live_ping_button_background</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Trivox.Input" parent="Widget.Trivox.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Trivox.SectionTitle" parent="Widget.Trivox.TextView">
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">11dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Trivox.FieldLabel" parent="Widget.Trivox.TextView">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
