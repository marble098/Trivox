<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trivox.Neon" parent="Theme.Trivox.Base">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryDark">@color/neon_surface</item>
        <item name="colorAccent">@color/neon_magenta</item>
        <item name="colorControlActivated">@color/neon_cyan</item>
        <item name="android:windowBackground">@color/neon_surface</item>
        <item name="android:colorBackground">@color/neon_surface</item>
        <item name="android:statusBarColor">@color/neon_surface</item>
        <item name="android:navigationBarColor">@color/neon_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/neon_text</item>
        <item name="android:textColorSecondary">@color/neon_cyan</item>
    </style>

    <style name="Theme.Trivox.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Widget.Trivox.Button.LivePing" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:fontFamily">@font/vazirmatn_semibold</item>
        <item name="android:background">@drawable/live_ping_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
