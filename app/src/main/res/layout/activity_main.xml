<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:textDirection="locale">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Trivox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:title="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/state_disconnected"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:minWidth="66dp"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textDirection="ltr"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/quickToolsToggle"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/input_background"
                android:contentDescription="@string/toggle_connection_tools"
                android:minWidth="38dp"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_more_rounded"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/quickToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/livePingText"
                    style="@style/Widget.Trivox.Button.LivePing"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/live_ping_click_hint"
                    android:minWidth="0dp"
                    android:text="@string/live_ping_off"
                    android:textDirection="ltr"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/realDelayText"
                    style="@style/Widget.Trivox.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/real_delay_click_hint"
                    android:minWidth="0dp"
                    android:text="@string/real_delay_off"
                    android:textDirection="ltr"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/exitInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/exit_info_off"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refreshExitButton"
                    style="@style/Widget.Trivox.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/refresh_exit_info"
                    android:enabled="false"
                    android:text="↻"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/copySummaryButton"
                    style="@style/Widget.Trivox.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/copy_summary"
                    android:enabled="false"
                    android:text="⧉"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="120dp"
            android:layout_height="42dp"
            android:background="@drawable/input_background"
            android:paddingStart="9dp"
            android:paddingEnd="9dp" />

        <EditText
            android:id="@+id/searchInput"
            style="@style/Widget.Trivox.Input"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/subscriptionTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="1dp"
                android:paddingEnd="1dp" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/refreshSubscriptionsButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/update_subscriptions"
            android:minWidth="42dp"
            android:padding="0dp"
            android:text="↻"
            android:textSize="19sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="5dp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/no_profiles"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/addButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:contentDescription="@string/add"
            android:minWidth="0dp"
            android:text="@string/add_short"
            android:textSize="11sp" />

        <Button
            android:id="@+id/testButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/tcp_ping_icon"
            android:textSize="11sp" />

        <Button
            android:id="@+id/realDelayAllButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/real_delay_all_icon"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/connectButton"
            style="@style/Widget.Trivox.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/connect"
            android:textSize="14sp" />

        <Button
            android:id="@+id/pauseButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/pause_connection"
            android:minWidth="52dp"
            android:padding="0dp"
            android:text="⏸"
            android:textSize="19sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
