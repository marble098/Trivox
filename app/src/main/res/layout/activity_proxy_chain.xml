<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" style="@style/Widget.Trivox.Toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:title="@string/add_proxy_chain"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_background" android:padding="12dp">
        <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/chain_name"/><EditText android:id="@+id/chainNameInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp"/>
        <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="10dp" android:text="@string/chain_exit"/><Spinner android:id="@+id/chainExitSpinner" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="3dp" android:background="@drawable/input_background" android:paddingStart="8dp" android:paddingEnd="8dp"/>
        <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="10dp" android:text="@string/chain_bridge"/><Spinner android:id="@+id/chainBridgeSpinner" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="3dp" android:background="@drawable/input_background" android:paddingStart="8dp" android:paddingEnd="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/chain_explanation" android:textColor="@color/muted" android:textSize="10sp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/chainCancelButton" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/cancel"/>
        <Button android:id="@+id/chainSaveButton" style="@style/Widget.Trivox.Button.Primary" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/save"/>
    </LinearLayout>
</LinearLayout>
