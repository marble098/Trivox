<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:textDirection="locale">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Trivox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:title="@string/settings"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/interface_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/language" />
                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/darkModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:text="@string/dark_theme"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:showText="false" />

                <CheckBox
                    android:id="@+id/hideIpOnMainCheck"
                    style="@style/Widget.Trivox.CheckBox"
                    android:text="@string/hide_ip_on_main" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/profile_sorting_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/sort_mode" />
                <Spinner
                    android:id="@+id/sortModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />
                <Button
                    android:id="@+id/manageSubscriptionsButton"
                    style="@style/Widget.Trivox.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/manage_subscriptions" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/ping_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/live_ping_method" />
                <Spinner
                    android:id="@+id/pingMethodSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />
                <TextView
                    android:id="@+id/pingMethodSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/livePingEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:text="@string/live_ping_enabled"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="8dp" android:text="@string/live_ping_interval" />
                <EditText
                    android:id="@+id/livePingIntervalInput"
                    style="@style/Widget.Trivox.Input"
                    android:layout_marginTop="3dp"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="8dp" android:text="@string/ping_attempts" />
                <Spinner
                    android:id="@+id/pingAttemptsSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="8dp" android:text="@string/ping_test_url" />
                <EditText
                    android:id="@+id/testUrlInput"
                    style="@style/Widget.Trivox.Input"
                    android:layout_marginTop="3dp"
                    android:inputType="textUri"
                    android:textDirection="ltr" />

                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="8dp" android:text="@string/real_delay_profile" />
                <Spinner android:id="@+id/realDelayProfileSpinner" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="3dp" android:background="@drawable/input_background" android:paddingStart="10dp" android:paddingEnd="8dp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_group_size" />
                <EditText android:id="@+id/realDelayGroupSizeInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_workers" />
                <EditText android:id="@+id/realDelayWorkersInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_timeout" />
                <EditText android:id="@+id/realDelayTimeoutInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_start_grace" />
                <EditText android:id="@+id/realDelayStartGraceInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_target_count" />
                <EditText android:id="@+id/realDelayTargetCountInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/real_delay_required_proofs" />
                <EditText android:id="@+id/realDelayRequiredProofsInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/network_tuning_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/network_tuning_summary"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/networkTuningEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:text="@string/network_tuning_enabled"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/adaptiveHandshakeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="@string/adaptive_handshake"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tcpFastOpenSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="@string/tcp_fast_open"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="5dp" android:text="@string/tcp_keepalive_idle" />
                <EditText android:id="@+id/tcpKeepAliveIdleInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/tcp_keepalive_interval" />
                <EditText android:id="@+id/tcpKeepAliveIntervalInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/tcp_user_timeout" />
                <EditText android:id="@+id/tcpUserTimeoutInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/network_buffer_size_kb" />
                <EditText android:id="@+id/networkBufferSizeInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/local_proxy_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/mixed_proxy_hint" />
                <EditText android:id="@+id/socksPort" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <CheckBox android:id="@+id/localProxyInVpnCheck" style="@style/Widget.Trivox.CheckBox" android:text="@string/local_proxy_in_vpn" />
                <Button android:id="@+id/telegramProxyButton" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="42dp" android:text="@string/open_telegram_proxy" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/vpn_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView style="@style/Widget.Trivox.FieldLabel" android:text="@string/mtu" />
                <EditText android:id="@+id/mtuInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <CheckBox android:id="@+id/ipv6Check" style="@style/Widget.Trivox.CheckBox" android:text="@string/ipv6" />
                <CheckBox android:id="@+id/blockingCheck" style="@style/Widget.Trivox.CheckBox" android:text="@string/blocking_mode" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/wireguard_section_v9" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wireguard_summary_v9" android:textColor="@color/muted" android:textSize="10sp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="8dp" android:text="@string/wireguard_mtu_v9" />
                <EditText android:id="@+id/wireGuardMtuInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/wireguard_workers_v9" />
                <Spinner android:id="@+id/wireGuardWorkersSpinner" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="3dp" android:background="@drawable/input_background" android:paddingStart="10dp" android:paddingEnd="8dp" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/wireguard_keepalive_v9" />
                <EditText android:id="@+id/wireGuardKeepAliveInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/wireguard_handshake_timeout_v9" />
                <EditText android:id="@+id/wireGuardHandshakeTimeoutInput" style="@style/Widget.Trivox.Input" android:layout_marginTop="3dp" android:inputType="number" android:textDirection="ltr" />
                <TextView style="@style/Widget.Trivox.FieldLabel" android:layout_marginTop="7dp" android:text="@string/wireguard_domain_strategy_v9" />
                <Spinner android:id="@+id/wireGuardDomainStrategySpinner" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="3dp" android:background="@drawable/input_background" android:paddingStart="10dp" android:paddingEnd="8dp" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/dns_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <Spinner android:id="@+id/dnsMode" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/input_background" android:paddingStart="10dp" android:paddingEnd="8dp" />
                <EditText
                    android:id="@+id/customDns"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/input_background"
                    android:gravity="top|start"
                    android:hint="@string/custom_dns_hint"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:textDirection="ltr"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/reconnect_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <CheckBox android:id="@+id/reconnectNetwork" style="@style/Widget.Trivox.CheckBox" android:text="@string/reconnect_network" />
                <CheckBox android:id="@+id/reconnectBoot" style="@style/Widget.Trivox.CheckBox" android:text="@string/reconnect_boot" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/update_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <CheckBox android:id="@+id/autoUpdateCheck" style="@style/Widget.Trivox.CheckBox" android:text="@string/auto_update_check" />
                <Button android:id="@+id/checkUpdateButton" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="42dp" android:text="@string/check_update_now" />
                <TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="10sp" />
            </LinearLayout>

            <TextView style="@style/Widget.Trivox.SectionTitle" android:text="@string/about_section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView android:id="@+id/aboutCreators" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/aboutAppVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textDirection="ltr" />
                <TextView android:id="@+id/aboutCoreVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textDirection="ltr" />
                <TextView android:id="@+id/aboutSigning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:maxLines="2" android:textColor="@color/text_secondary" android:textDirection="ltr" />
                <TextView android:id="@+id/aboutPackage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.Trivox.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/save" />
</LinearLayout>
