<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:textDirection="locale">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Trivox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:title="@string/settings"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/interface_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/Widget.Trivox.FieldLabel"
                    android:text="@string/language" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/local_proxy_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/Widget.Trivox.FieldLabel"
                    android:text="@string/mixed_proxy_hint" />

                <EditText
                    android:id="@+id/socksPort"
                    style="@style/Widget.Trivox.Input"
                    android:layout_marginTop="4dp"
                    android:hint="@string/mixed_port"
                    android:inputType="number"
                    android:textDirection="ltr" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/vpn_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <EditText
                    android:id="@+id/mtuInput"
                    style="@style/Widget.Trivox.Input"
                    android:hint="@string/mtu"
                    android:inputType="number" />

                <CheckBox
                    android:id="@+id/ipv6Check"
                    style="@style/Widget.Trivox.CheckBox"
                    android:layout_marginTop="4dp"
                    android:text="@string/ipv6" />

                <CheckBox
                    android:id="@+id/blockingCheck"
                    style="@style/Widget.Trivox.CheckBox"
                    android:text="@string/blocking_mode" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/dns_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <Spinner
                    android:id="@+id/dnsMode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/input_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />

                <EditText
                    android:id="@+id/customDns"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/input_background"
                    android:fontFamily="@font/vazirmatn"
                    android:gravity="top|start"
                    android:hint="@string/custom_dns_hint"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:textDirection="ltr"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/reconnect_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="10dp">

                <CheckBox
                    android:id="@+id/reconnectNetwork"
                    style="@style/Widget.Trivox.CheckBox"
                    android:text="@string/reconnect_network" />

                <CheckBox
                    android:id="@+id/reconnectBoot"
                    style="@style/Widget.Trivox.CheckBox"
                    android:text="@string/reconnect_boot" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Trivox.SectionTitle"
                android:text="@string/about_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Widget.Trivox.FieldLabel"
                    android:text="@string/about_creators_label" />

                <TextView
                    android:id="@+id/aboutCreators"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/text_primary"
                    android:textDirection="locale"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aboutAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:textColor="@color/text_primary"
                    android:textDirection="locale"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aboutCoreVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/vazirmatn"
                    android:textColor="@color/text_primary"
                    android:textDirection="locale"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aboutSigning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/vazirmatn"
                    android:textColor="@color/muted"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/aboutPackage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/vazirmatn"
                    android:textColor="@color/muted"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.Trivox.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:text="@string/save" />
</LinearLayout>
