<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    android:textDirection="locale">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Trivox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:title="@string/app_routing"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            style="@style/Widget.Trivox.FieldLabel"
            android:text="@string/routing_mode_label" />

        <Spinner
            android:id="@+id/routingMode"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/input_background"
            android:paddingStart="10dp"
            android:paddingEnd="8dp" />

        <CheckBox
            android:id="@+id/showSystem"
            style="@style/Widget.Trivox.CheckBox"
            android:layout_marginTop="3dp"
            android:text="@string/show_system_apps" />
    </LinearLayout>

    <TextView
        style="@style/Widget.Trivox.SectionTitle"
        android:text="@string/applications" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background"
        android:padding="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/loading_apps"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </FrameLayout>

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.Trivox.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:text="@string/save" />
</LinearLayout>
