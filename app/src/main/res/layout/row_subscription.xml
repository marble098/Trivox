<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/panel_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/subscriptionKindBadge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/input_background"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/blue"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subscriptionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subscriptionStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/input_background"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/subscriptionUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textDirection="ltr"
        android:textIsSelectable="true"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/subscriptionSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/subscriptionError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/input_background"
        android:padding="8dp"
        android:textColor="@color/red"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="9dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/subscriptionUpdateButton"
            style="@style/Widget.Trivox.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/update"
            android:textSize="10sp" />

        <Button
            android:id="@+id/subscriptionEditButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/edit_subscription"
            android:textSize="10sp" />

        <Button
            android:id="@+id/subscriptionEnableButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/disable"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/subscriptionDeleteButton"
        style="@style/Widget.Trivox.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:text="@string/delete_subscription"
        android:textColor="@color/red"
        android:textSize="10sp" />
</LinearLayout>
