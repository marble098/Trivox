<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:textDirection="locale">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Trivox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:title="@string/diagnostics"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <TextView
        style="@style/Widget.Trivox.SectionTitle"
        android:text="@string/sanitized_report" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/reportText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_regular"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textDirection="firstStrong"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/refreshDiagnosticsButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/refresh_diagnostics" />

        <Button
            android:id="@+id/copyDiagnosticsButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/copy_diagnostics" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/clearDiagnosticsButton"
            style="@style/Widget.Trivox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/clear_diagnostics" />

        <Button
            android:id="@+id/exportButton"
            style="@style/Widget.Trivox.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.35"
            android:text="@string/export_diagnostics" />
    </LinearLayout>
</LinearLayout>
