<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" style="@style/Widget.Trivox.Toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:title="@string/add_manual_config" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
            <Button android:id="@+id/addProxyChain" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_proxy_chain" />
            <Button android:id="@+id/addVmess" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_vmess" />
            <Button android:id="@+id/addVless" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_vless" />
            <Button android:id="@+id/addShadowsocks" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_shadowsocks" />
            <Button android:id="@+id/addSocks" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_socks" />
            <Button android:id="@+id/addHttp" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_http" />
            <Button android:id="@+id/addTrojan" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_trojan" />
            <Button android:id="@+id/addWireguard" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:text="@string/add_wireguard" />
            <Button android:id="@+id/addHysteria2" style="@style/Widget.Trivox.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/add_hysteria2" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
