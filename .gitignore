# Local Android/Gradle state
.gradle/
**/build/
local.properties
signing.properties
*.jks
*.keystore
# Throwaway self-signed cert used only by loopback HTTPS test fixtures
# (password "changeit", no real secret) - intentionally tracked.
!app/src/test/resources/test-keystore.jks

